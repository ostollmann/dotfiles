[user]
	email = oliver@stollmann.net
	name = Oliver Stollmann
[color]
	ui = auto
[core]
	editor = vim
	ignorecase = false
[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    df = diff
    dc = diff --cached
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    rl = reflog
[merge]
	tool = vimdiff
[init]
	defaultBranch = master
[pull]
	ff = only
